{
  "name": "okc-onsite-detailing",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "images": "node scripts/build-images.mjs",
    "art": "node scripts/generate-art.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
